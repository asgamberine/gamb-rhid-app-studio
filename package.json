{
  "name": "gamb-rhid",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --use-system-ca scripts/start-dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --use-system-ca server/index.mjs",
    "dev:homolog": "vite --open /gamb_rhid/homolog-preview.html",
    "start": "node --use-system-ca scripts/start-production.mjs",
    "external": "node --use-system-ca scripts/start-external.mjs",
    "rhid:punch": "node --use-system-ca scripts/rhid-punch.mjs",
    "rhid:automation": "node --use-system-ca scripts/rhid-automation.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "node scripts/write-version.mjs && npm run typecheck && vite build && node scripts/generate-service-worker.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --report-unused-disable-directives --max-warnings 0",
    "test": "TZ=America/Sao_Paulo vitest run",
    "verify:homolog": "node scripts/verify-homolog.mjs && npm run lint && npm run typecheck && npm test && npm run build",
    "verify:release": "npm test && npm test && npm run build",
    "deploy:force": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-force.ps1",
    "generate:pwa-assets": "pwa-assets-generator --preset minimal-2023 public/icon.svg",
    "preview": "vite preview"
  },
  "dependencies": {
    "@flaticon/flaticon-uicons": "^3.3.1",
    "better-sqlite3": "^13.0.3",
    "dayjs": "^1.11.13",
    "primereact": "^11.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "form-data": "^4.0.6",
    "js-yaml": "^4.3.0",
    "sharp": "^0.35.4"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.2.13"
  }
}
